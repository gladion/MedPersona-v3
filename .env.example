# Copy this file to .env and fill in your own MongoDB Atlas connection string.
# .env is only used for local development - on Render, set this as an
# Environment Variable in the service's dashboard instead (see README.md,
# "Database setup").

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Optional - defaults to "medsim_review" if not set.
# MONGODB_DB_NAME=medsim_review

# Optional - defaults to 3000 if not set.
# PORT=3000
